#!/usr/bin/env bash
# Minimal stand-in for `scrcpy`, driven by environment variables (see tests):
#   FAKE_SCRCPY_VERSION      version printed by --version (default 2.4)
#   FAKE_SCRCPY_LOG          file that receives the arguments and $ADB
#   FAKE_SCRCPY_EXIT         if set, exit immediately with this status
#   FAKE_SCRCPY_IGNORE_TERM  if set, ignore SIGTERM (forces a kill)
if [ "$1" = "--version" ]; then
    echo "scrcpy ${FAKE_SCRCPY_VERSION:-2.4} <https://github.com/Genymobile/scrcpy>"
    exit 0
fi
if [ -n "$FAKE_SCRCPY_LOG" ]; then
    { printf '%s\n' "$@"; echo "ADB=$ADB"; } > "$FAKE_SCRCPY_LOG"
fi
# Install the signal handling before the first output line: tests wait for that
# line, so they never signal a script that has not set up its trap yet.
if [ -n "$FAKE_SCRCPY_IGNORE_TERM" ]; then
    trap '' TERM
else
    trap 'echo "INFO: bye"; exit 0' TERM INT
fi
echo "INFO: Device: Fake Phone"
echo "WARN: something on stderr" >&2
if [ -n "$FAKE_SCRCPY_EXIT" ]; then
    echo "ERROR: boom" >&2
    exit "$FAKE_SCRCPY_EXIT"
fi
while true; do sleep 0.05; done
