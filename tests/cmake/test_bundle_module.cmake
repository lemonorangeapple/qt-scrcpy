# Tests cmake/QtScrcpyBundle.cmake end to end without network and without the real scrcpy
# packages: it builds small stand-in packages, configures tests/cmake/harness against them and
# checks what happens. Run with:
#   cmake -DMODULE_DIR=<repo>/cmake -DHARNESS_DIR=<repo>/tests/cmake/harness -DWORK_DIR=<dir> [-DPYTHON=<python3>] -P test_bundle_module.cmake
cmake_minimum_required(VERSION 3.16)

foreach(required MODULE_DIR HARNESS_DIR WORK_DIR)
    if(NOT ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()

file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")

set(failures 0)
set(case_number 0)

function(check_true description)
    if(NOT (${ARGN}))
        message(SEND_ERROR "FAILED: ${description}")
        math(EXPR failures "${failures} + 1")
        set(failures ${failures} PARENT_SCOPE)
    else()
        message(STATUS "ok: ${description}")
    endif()
endfunction()

# ---- stand-in package --------------------------------------------------------------------
# tar.gz laid out like the scrcpy release packages: one top-level directory with the programs
# (shell stubs), the server file, an icon and files that must NOT be bundled.
function(make_package out_archive out_hash name)
    set(tree "${WORK_DIR}/tree-${name}")
    set(top "${tree}/scrcpy-fake-v1.0")
    file(MAKE_DIRECTORY "${top}")
    foreach(program scrcpy adb)
        file(WRITE "${top}/${program}" "#!/bin/sh\necho fake ${program}\n")
        execute_process(COMMAND chmod 755 "${top}/${program}")
    endforeach()
    file(WRITE "${top}/scrcpy-server" "server ${ARGN}\n")
    file(WRITE "${top}/icon.png" "png\n")
    file(WRITE "${top}/scrcpy.1" "man\n")
    file(WRITE "${top}/evil.bat" "@echo off\n")
    execute_process(COMMAND ${CMAKE_COMMAND} -E tar czf "${WORK_DIR}/${name}.tar.gz" "scrcpy-fake-v1.0"
                    WORKING_DIRECTORY "${tree}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "could not create the test package ${name}")
    endif()
    file(SHA256 "${WORK_DIR}/${name}.tar.gz" hash)
    set(${out_archive} "${WORK_DIR}/${name}.tar.gz" PARENT_SCOPE)
    set(${out_hash} "${hash}" PARENT_SCOPE)
endfunction()

# Configures (and optionally builds) the harness; sets <prefix>_rc and <prefix>_out.
function(run_harness prefix)
    cmake_parse_arguments(ARG "BUILD;SUBDIRECTORY" "NAME;DIR;HARNESS" "OPTIONS;ENV" ${ARGN})
    set(source_dir "${HARNESS_DIR}")
    if(ARG_HARNESS)
        set(source_dir "${ARG_HARNESS}")
    endif()
    math(EXPR n "${case_number} + 1")
    set(case_number ${n} PARENT_SCOPE)
    set(build_dir "${WORK_DIR}/case-${n}-${ARG_NAME}")
    if(ARG_DIR)
        set(build_dir "${WORK_DIR}/${ARG_DIR}") # a directory name chosen by the case
    endif()
    file(REMOVE_RECURSE "${build_dir}")
    set(options -DMODULE_DIR=${MODULE_DIR} -DQTSCRCPY_DOWNLOAD_DIR=${build_dir}/dl ${ARG_OPTIONS})
    if(ARG_SUBDIRECTORY)
        list(APPEND options -DUSE_SUBDIRECTORY=ON)
    endif()
    execute_process(COMMAND ${CMAKE_COMMAND} -E env ${ARG_ENV} ${CMAKE_COMMAND} -S "${source_dir}" -B "${build_dir}" ${options}
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set(all "${out}\n${err}")
    if(ARG_BUILD AND rc EQUAL 0)
        execute_process(COMMAND ${CMAKE_COMMAND} --build "${build_dir}" RESULT_VARIABLE build_rc OUTPUT_VARIABLE build_out ERROR_VARIABLE build_err)
        set(all "${all}\n${build_out}\n${build_err}")
        if(NOT build_rc EQUAL 0)
            set(rc ${build_rc})
        endif()
    endif()
    # CMake wraps long messages at arbitrary places; compare with whitespace collapsed.
    string(REGEX REPLACE "[ \t\r\n]+" " " all "${all}")
    set(${prefix}_rc ${rc} PARENT_SCOPE)
    set(${prefix}_out "${all}" PARENT_SCOPE)
    set(${prefix}_dir "${build_dir}" PARENT_SCOPE)
endfunction()

make_package(good_archive good_hash good "A")

